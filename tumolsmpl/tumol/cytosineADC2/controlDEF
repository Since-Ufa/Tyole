$operating system unix
$title
imotifm
$maxcor    400 MiB  per_core
$coord    file=coord
$symmetry    c1
$atoms
n  1,4,6                                                                       \
   basis =n aug-cc-pVDZ                                                        \
   cbas  =n aug-cc-pVDZ
c  2,5,7-8                                                                     \
   basis =c aug-cc-pVDZ                                                        \
   cbas  =c aug-cc-pVDZ
o  3                                                                           \
   basis =o aug-cc-pVDZ                                                        \
   cbas  =o aug-cc-pVDZ
h  9-13                                                                        \
   basis =h cc-pVDZ                                                            \
   cbas  =h cc-pVDZ
$basis    file=basis
$cbas    file=auxbasis # auxiliary basis set.
# $cosmo_out    file=job_notRun_1.cosmo
$scfmo   file=mos
$ricc2
adc(2)
$closed shells
 a       1-29                                   ( 2 )
$freeze
implicit core= 8  virt= 0
$pointval mo 22-40 fmt=cub
$anadens
 calc cedd08 from
 1d0 adcp2-xsdn-1a-008-total.cao
 -1d0 mp2-gsdn-1a-000-total.cao
$pointval fmt=cub
$excitations
irrep=a nexc=8
spectrum states=all operators=diplen,qudlen
 xgrad states=(a 1-8)
$response
 gradient
# $cdspectrum    nm
$spectrum    nm
$tmole
$denconv    1d-7
$ricore    100
$optimize
 internal   off
 redundant  off
 cartesian  on
 global     off
 basis      off
$subtitle
SP,CC2/RI,charge 0,c1,mixed basis set,EX-STATE
$rundimensions
   dim(fock,dens)=25752
   natoms=13
   nshell=87
   nbf(CAO)=225
   nbf(AO)=209
   dim(trafo[SAO<-->AO/CAO])=257
   rhfshells=1
$scfconv    7
$scfdamp     start=0.700 step=0.050 min=0.100
$scfdump
$scfiterlimit      350
$thize     0.10000000E-04
$thime        5
$scfintunit
 unit=30       size=0        file=twoint
$scfdiis
$scforbitalshift  automatic=.1
$drvopt
   cartesian  on
   basis      off
   global     off
   hessian    on
   dipole     on
   nuclear polarizability
$forceinit on
   diag=default
$forceapprox    file=forceapprox
$lock off
$energy    file=energy
$grad    file=gradient
$last step     define
$end
