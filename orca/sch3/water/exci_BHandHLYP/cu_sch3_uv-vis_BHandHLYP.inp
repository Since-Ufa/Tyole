# opt in mp2/def2tzvp

! BHandHLYP TightSCF def2-TZVP slowconv PModel cpcm(water) 

%maxcore 1500

%tddft
 nroots 20
 maxdim 60
 triplets false
end

%output
Print[ P_Basis ] 2
Print[ P_MOs ] 1
end

%pal nprocs=16 end
%base "0_CuC2H6S2"
*xyz -1 1

*

$new_job


